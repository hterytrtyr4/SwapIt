# SwapIt environment configuration
# Copy this file to .env and adjust the values.

# Secret key used to sign sessions and CSRF tokens.
# Generate a strong value:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database URI. Relative SQLite paths resolve inside the instance/ folder.
# For production use Postgres (e.g. Supabase transaction pooler):
#   DATABASE_URL=postgresql://user:pass@host:6543/postgres?sslmode=require
# (postgres:// and postgresql:// URIs are normalised to the psycopg2 driver.)
DATABASE_URL=sqlite:///swapit.db

# Config profile: "production" (HTTPS-only cookies) | "testing" | empty = default
FLASK_CONFIG=

# Force HTTPS-only session cookies (on automatically when FLASK_CONFIG=production).
SESSION_COOKIE_SECURE=0

# Create tables on startup (bootstrap convenience). Set 0 once you run migrations.
AUTO_CREATE_DB=1

# Image storage backend:
#   local = write processed images under static/uploads (classic hosting)
#   db    = store image bytes in the database (serverless / read-only filesystems)
MEDIA_BACKEND=local

# Set to 1 to load Bootstrap + Bootstrap Icons from the jsDelivr CDN instead
# of the vendored copies in static/vendor (useful on serverless hosts).
ASSET_CDN=0

# Where local-mode uploads are written (default: static/uploads).
# UPLOAD_FOLDER=static/uploads

# Max request/upload size in megabytes.
MAX_UPLOAD_MB=5

# Set to 1 to enable Flask debug mode (never enable in production).
FLASK_DEBUG=0

# Dev server binding (production uses gunicorn).
PORT=5000
HOST=0.0.0.0
